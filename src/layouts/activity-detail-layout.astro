---
import SiteLayout from './site-layout.astro';

export interface Props {
  title?: string;
}

const { title = 'Activity' } = Astro.props;
---

<SiteLayout title={title}>
  <div style="width: 100%; margin-left: auto; margin-right: auto;">
    <div style="display: flex; justify-content: space-between;">
      <h3 style="text-align: left; font-weight: bold; font-size: 1.17em; text-indent: 20px;">Activities</h3>
      <h3 style="text-align: right;">
        <a href="/activities" style="text-decoration: none; color: #116071;">Back</a>
      </h3>
    </div>
    <slot />
  </div>
</SiteLayout>
