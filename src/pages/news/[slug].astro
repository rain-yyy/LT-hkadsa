---
import { getCollection, render } from 'astro:content';
import NewsDetailLayout from '../../layouts/news-detail-layout.astro';

export async function getStaticPaths() {
  const newsItems = await getCollection('news', ({ data }) => data.type === 'internal');
  return newsItems.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<NewsDetailLayout title={item.data.title}>
  <h2 class="center">{item.data.title}</h2>
  <Content />
</NewsDetailLayout>
