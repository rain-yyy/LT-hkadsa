---
import { getCollection } from 'astro:content';
import ActivityDetailLayout from '../../layouts/activity-detail-layout.astro';

export async function getStaticPaths() {
  const activities = await getCollection('activities', ({ data }) => !data.externalUrl);
  return activities.map((activity) => ({
    params: { slug: activity.slug },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const { Content } = await activity.render();
---

<ActivityDetailLayout title={activity.data.title}>
  <Content />
</ActivityDetailLayout>
